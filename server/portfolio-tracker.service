[Unit]
Description=Portfolio Tracker Pro Server
After=network.target

[Service]
Type=simple
User=skynet
WorkingDirectory=/home/skynet/.openclaw/workspace/portfolio-tracker/server
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production
Environment=PORT=8080

[Install]
WantedBy=multi-user.target
